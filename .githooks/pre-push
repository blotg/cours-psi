#!/bin/sh
#
# Reconstruit le site du cours (HTML) avant un push, et le publie si on le lui
# demande.
#
# - Le site est produit dans site/, ignore par git (cf. .gitignore) : il ne
#   part jamais dans un commit de la branche de travail.
# - La publication est *desactivee par defaut*. Le site est public : y pousser
#   le cours est une decision, pas un effet de bord d'un push. Pour l'activer :
#       git config hooks.site true
#   Le hook cree alors la branche gh-pages a partir de site/ et la pousse. Il
#   reste a dire une fois a GitHub de servir Pages depuis cette branche.
# - Un echec de construction n'annule pas le push : simple avertissement.
#   Pour contourner le hook entierement :  git push --no-verify
#
# Activation (une fois par clone) :  git config core.hooksPath .githooks
#
# Prerequis : `typst` dans le PATH, et le venv d'outils/ (cf. outils/README.md).

remote=$1

git() { command git -c core.quotePath=false "$@"; }

cd "$(git rev-parse --show-toplevel)" || exit 1

# La branche par defaut du depot : c'est la seule dont un push reconstruit le
# site. Pousser une branche de travail ne doit rien publier.
principale=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)
principale=${principale#origin/}
[ -n "$principale" ] || principale=$(git rev-parse --abbrev-ref HEAD)

# git alimente l'entree standard avec « <ref locale> <sha> <ref distante> <sha> »
# pour chaque ref poussee. On ne se reveille que si la principale en fait partie.
concernee=0
while read -r ref_locale _ ref_distante _; do
    [ "$ref_locale" = "refs/heads/$principale" ] && concernee=1
    [ "$ref_distante" = "refs/heads/$principale" ] && concernee=1
done
[ "$concernee" -eq 1 ] || exit 0

PY=""
if [ -x outils/.venv/bin/python ]; then
    PY=outils/.venv/bin/python
elif command -v python3 >/dev/null 2>&1; then
    PY=python3
fi
if [ -z "$PY" ]; then
    printf '\n  Avertissement : python introuvable, site non reconstruit.\n\n'
    exit 0
fi

printf '  site   construction (quelques minutes)...\n'
if ! "$PY" -m outils site >/dev/null; then
    printf '\n  Avertissement : la construction du site a echoue, le push continue.\n'
    printf '  Pour voir l erreur :  %s -m outils site\n\n' "$PY"
    exit 0
fi
printf '  site   %s pages dans site/\n' "$(find site -name '*.html' | wc -l | tr -d ' ')"

if [ "$(git config --bool hooks.site 2>/dev/null)" != true ]; then
    printf '  site   publication desactivee (git config hooks.site true pour l activer)\n'
    exit 0
fi

# --- Publication sur gh-pages --------------------------------------------
#
# On fabrique le commit avec les commandes de plomberie plutot qu'en changeant
# de branche : l'index et l'arbre de travail de l'utilisateur ne sont pas
# touches, et un `git push` reste un `git push`.
# mktemp cree un fichier *vide*, que git refuse comme index (« fichier d'index
# plus petit qu'attendu ») : il lui faut un chemin encore inexistant.
tampon=$(mktemp -d) || exit 0
trap 'rm -rf "$tampon"' EXIT
GIT_INDEX_FILE=$tampon/index
export GIT_INDEX_FILE

if ! git --work-tree=site add --all --force . 2>/dev/null; then
    printf '  site   Avertissement : indexation impossible, publication ignoree.\n'
    exit 0
fi

arbre=$(git write-tree) || exit 0
parent=$(git rev-parse --verify --quiet refs/heads/gh-pages)
message="Site du cours — $(git rev-parse --short HEAD)"
if [ -n "$parent" ]; then
    # Rien de neuf : inutile de fabriquer un commit vide.
    if [ "$(git rev-parse "$parent^{tree}")" = "$arbre" ]; then
        printf '  site   inchange, rien a publier\n'
        exit 0
    fi
    commit=$(printf '%s\n' "$message" | git commit-tree "$arbre" -p "$parent")
else
    commit=$(printf '%s\n' "$message" | git commit-tree "$arbre")
fi
[ -n "$commit" ] || exit 0

git update-ref refs/heads/gh-pages "$commit"
printf '  site   publication sur %s (gh-pages)\n' "$remote"
git push --quiet "$remote" refs/heads/gh-pages:refs/heads/gh-pages || {
    printf '  site   Avertissement : le push de gh-pages a echoue.\n'
}
exit 0
