#!/bin/sh
#
# Recompile les documents (cours / TD / poly / TP / evaluation) des chapitres
# dont une source apparait dans le commit en cours.
#
# - Tout est produit dans <chapitre>/build/, sous le nom « <type> - <titre
#   court>.pdf » (le titre court vient de infos.yml). Ce dossier est ignore
#   par git (cf. .gitignore) :
#   rien n'est donc ajoute au commit. Le hook sert a garder ces documents a
#   jour sur le disque et a verifier que les sources compilent encore.
# - Un document est (re)genere qu'il existe deja ou non.
# - Ce qui se tire du cours plutot que d'une source propre (DM recopies,
#   flashcards Anki et planche a decouper, liste des manipulations) est
#   produit dans la foulee par `python3 -m outils build`, si les dependances
#   sont installees (cf. outils/README.md).
# - Une modif sous prepa/ => tous les chapitres sont recompiles.
# - Un chapitre qui ne compile pas : simple avertissement, le commit continue.
#   Pour annuler le commit dans ce cas :
#       git config hooks.typstStrict true
#   Contourner le hook entierement :  git commit --no-verify
#
# Activation (une fois par clone) :  git config core.hooksPath .githooks
#
# Prerequis : `typst` dans le PATH.

export SOURCE_DATE_EPOCH="${SOURCE_DATE_EPOCH:-0}"   # sortie PDF reproductible

# Dossier de sortie, relatif au dossier du chapitre (ignore par git).
OUT=build

# Documents produits a partir d'une source typst du meme nom, dans un dossier
# de chapitre ou de TP. Ce sont eux (et eux seuls) que le hook recompile.
# (une par ligne : IFS vaut newline au moment de la boucle)
docs='cours
TD
poly
TP
évaluation'

# core.quotePath=false : chemins accentues en clair (sinon "\303\251"...)
git() { command git -c core.quotePath=false "$@"; }

# Titre court d'un chapitre, tel qu'il apparait dans le nom des documents
# produits : le champ `titre-court` de son infos.yml. A defaut (les TP n'ont
# pas d'infos.yml), le nom du dossier prive de son prefixe de classement,
# « 2 - Filtre de Wien » donnant « Filtre de Wien ».
titre_court() {
    tc=$(sed -n 's/^titre-court:[[:space:]]*//p' "$1/infos.yml" 2>/dev/null | head -1 \
        | sed -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*\)'\$/\1/" -e 's/[[:space:]]*$//')
    [ -n "$tc" ] || tc=$(basename "$1" | sed 's/^[0-9]*[[:space:]]*-[[:space:]]*//')
    printf '%s' "$tc"
}

cd "$(git rev-parse --show-toplevel)" || exit 1

# Fichiers Ajoutes / Copies / Modifies / Renommes dans l'index
changed=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$changed" ] || exit 0

# Extensions dont depend un rendu
ext_rx='\.(typ|ya?ml|csv|json|txt|dat|png|jpe?g|svg|gif|webp|bmp|tiff?)$'

# --- Dossiers-chapitres a recompiler --------------------------------------
if printf '%s\n' "$changed" | grep -qE '^prepa/'; then
    dirs=$(git ls-files '*/cours.typ' '*/poly.typ' '*/TP.typ' '*/évaluation.typ' \
        | sed 's#/[^/]*$##' | sort -u)
else
    dirs=$(
        printf '%s\n' "$changed" | grep -E "$ext_rx" | while IFS= read -r f; do
            d=${f%/*}
            while [ "$d" != "$f" ] && [ -n "$d" ]; do
                if [ -e "$d/cours.typ" ] || [ -e "$d/poly.typ" ] || [ -e "$d/TP.typ" ] \
                    || [ -e "$d/évaluation.typ" ]; then
                    printf '%s\n' "$d"
                    break
                fi
                f=$d
                d=${d%/*}
            done
        done | sort -u
    )
fi
[ -n "$dirs" ] || exit 0

# --- Compilation ---------------------------------------------------------
fail=0
IFS='
'
for d in $dirs; do
    tc=$(titre_court "$d")
    for base in $docs; do
        [ -f "$d/$base.typ" ] || continue

        printf '  typst  %s/%s/%s - %s.pdf\n' "$d" "$OUT" "$base" "$tc"
        # typst ne cree pas le dossier de sortie
        mkdir -p "$d/$OUT" || { fail=1; continue; }
        ( cd "$d" && typst compile --diagnostic-format short "$base.typ" "$OUT/$base - $tc.pdf" ) || fail=1
    done
done

# --- DM, flashcards, manipulations ----------------------------------------
# On prefere le venv du depot, sinon le python du systeme.
PY=""
if [ -x outils/.venv/bin/python ]; then
    PY=outils/.venv/bin/python
elif command -v python3 >/dev/null 2>&1; then
    PY=python3
fi

if [ -n "$PY" ] && [ -d outils ]; then
    chapitres=""
    for d in $dirs; do
        [ -f "$d/cours.typ" ] && chapitres="$chapitres
$d"
    done
    if [ -n "$chapitres" ]; then
        # shellcheck disable=SC2086
        printf '%s' "$chapitres" | sed '/^$/d' | tr '\n' '\0' \
            | xargs -0 "$PY" -m outils build || {
                printf '\n  Avertissement : `outils build` a echoue.\n'
                printf '  Dependances :  outils/.venv/bin/pip install -r outils/requirements.txt\n\n'
            }
    fi
fi

if [ "$fail" -ne 0 ]; then
    if [ "$(git config --bool hooks.typstStrict 2>/dev/null)" = true ]; then
        printf '\n  Compilation typst en echec -- commit annule (hooks.typstStrict).\n'
        printf '  Corrige, ou : git commit --no-verify\n\n'
        exit 1
    fi
    printf '\n  Avertissement : PDF non regeneres pour les chapitres ci-dessus.\n'
    printf '  Le commit continue (les sources, elles, sont bien commitees).\n\n'
fi
exit 0
