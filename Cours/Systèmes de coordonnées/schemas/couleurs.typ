// Les couleurs des coordonnées, celles des animations du chapitre (palette
// d'Okabe et Ito, cf. animations/systemes.js) : la première coordonnée (x, r)
// en vermillon, la deuxième (y, θ) en bleu, la troisième (z, φ) en vert. Une
// arête, une cote ou un rayon prend la couleur de la coordonnée qu'il mesure.
#let vermillon = rgb("#d55e00")
#let bleu = rgb("#0072b2")
#let vert = rgb("#009e73")
