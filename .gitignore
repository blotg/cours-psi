# LaTeX build artifacts
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
*.bbl
*.blg

# Typst build cache
*.typstcache/

# Editor / OS backups & temp files
*~
*.swp
.goutputstream-*
.DS_Store

# Editor preferences
.vscode/

# Documents produits (cours.pdf, poly.pdf, TD.pdf, flashcards.apkg...) : un
# dossier build/ par chapitre, regenere par le hook pre-commit. Les PDF qui ne
# sont pas produits ici (datasheet, sujets et corriges de DM, corriges scannes,
# documents fournis...) vivent a la racine du chapitre et restent suivis.
build/

# environnements virtuels python
.venv/
__pycache__/

# Site HTML, reconstruit par le hook pre-push et publie sur gh-pages :
# rien a suivre sur la branche de travail (cf. outils/README.md).
site/

# Ce qui a servi à fabriquer chaque page du site, pour ne recompiler que ce qui
# a bougé (cf. outils/site.py). Purement local : l'effacer refait tout.
.site-manifeste.json

# Empreinte du dernier notebook envoyé sur Capytale pour chaque exercice (cf.
# outils/capytale.py). L'effacer fait tout renvoyer, et sauvegarder d'abord le
# contenu des activités.
.capytale-manifeste.json

# Contenu des activités Capytale avant qu'un premier envoi ne les écrase.
.capytale-sauvegardes/

# Liste de taches personnelle, purement locale.
